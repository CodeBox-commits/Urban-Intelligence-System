# Local development environment variables for UrbanIQ backend
# Prefer a MySQL URL for production, e.g. mysql+pymysql://user:password@localhost:3306/urbaniq
# For quick local testing the app will fall back to sqlite if no DB URL is provided.

# Primary DB connection (preferred)
URBANIQ_DATABASE_URL=sqlite:///./urbaniq_dev.db
# Legacy fallback (optional)
DATABASE_URL=

# Supabase auth settings (used for signup/login token validation)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Comma separated admin emails allowed to access admin endpoints
ADMIN_EMAILS=admin@urbaniq.com

# Paths (relative to repo root)
MODEL_DIR=models
DATA_DIR=data
